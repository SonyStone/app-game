{
  "manifest_version": 3,
  "name": "Bookmarks Explorer",
  "description": "Explore browser tabs, bookmarks, history, and saved sessions.",
  "version": "0.0.1",
  "action": {
    "default_title": "Open Bookmarks Explorer",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs", "bookmarks", "history", "sessions", "storage", "favicon"],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
