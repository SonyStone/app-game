  },
  "exports": {
    "./App": "./src/App.tsx",
    "./WebApp": "./src/WebApp.tsx",
    "./backend": "./src/explorer/backend.ts",
    "./document-backend": "./src/backends/document/createDocumentExplorerBackend.ts",
    "./portable": "./src/explorer/portable.ts",
