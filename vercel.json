{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "bunVersion": "1.4.x",
  "redirects": [
    { "source": "/tanki", "destination": "https://tanki-delta.vercel.app/", "permanent": true },
    { "source": "/tanki/:path*", "destination": "https://tanki-delta.vercel.app/:path*", "permanent": true }
  ],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "git": { "deploymentEnabled": { "**": false, "master": true } }
}
